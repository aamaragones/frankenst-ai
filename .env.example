# Secrets resolve env-first; set this to fall back to Azure Key Vault (DefaultAzureCredential).
AZURE_KEY_VAULT_NAME=

# azure_ai provider (config_llms.yaml)
AZURE_FOUNDRY_PROJECT_ENDPOINT=
AZURE_INFERENCE_MODEL_NAME=
AZURE_EMBEDDINGS_ENDPOINT=
AZURE_EMBEDDINGS_MODEL_NAME=

# databricks provider (config_llms.yaml); auth comes from the SDK default chain
DATABRICKS_LLM_ENDPOINT=
DATABRICKS_EMBEDDINGS_ENDPOINT=

# ollama provider under WSL: where the Windows-side server listens
OLLAMA_WINDOWS_BASE_URL=

# Azure AI Search and Blob Storage (ai_search_rag layout, Functions app)
AZURE_SEARCH_SERVICE_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_BLOB_STORAGE_NAME=

# Azure Application Insights
APPLICATION_INSIGHTS_CONNECTION_STRING=

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=false
